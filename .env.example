# Copy to .env for local development. Do not put real secrets in this file.

# Postgres connection string. Railway injects this on the app service when a
# Postgres plugin is attached.
DATABASE_URL=postgres://user:password@localhost:5432/ab_platform

# Owner login password. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_API_KEY=

# Signs session cookies and preview/edit links. At least 32 characters, any
# character set (it does not have to be hex or base64). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# When NODE_ENV=production the server refuses to boot if this is missing or
# shorter than 32 characters. Outside production a dev-only fallback is used
# and a warning is logged. Set the real value on the host before deploying.
SESSION_SECRET=

# production turns on HTTPS-only cookies and Postgres SSL.
NODE_ENV=development

# Strict-Transport-Security max-age, in seconds. Sent only on HTTPS requests
# (Railway sets X-Forwarded-Proto; the app trusts that proxy). Unset uses
# 15552000 (180 days). No includeSubDomains and no preload. Set to 0 to send
# max-age=0, which tells browsers that already stored the policy to drop it.
# That is the rollback. Invalid values are ignored and the default is used.
HSTS_MAX_AGE=

# Port the HTTP server listens on. Railway sets this.
PORT=3000

# How experiments with no site domain are served.
# transition (default) still serves them. enforce never serves them.
HOST_SCOPING=transition

# Public origin shown in the admin UI for the snippet tag and the client login
# link. No trailing slash. Must be an http or https origin (scheme, host, and
# an optional port). If this is unset or not a valid origin, the admin page
# uses the browser's current origin instead. Unset it to roll back.
# Example: https://pivitlab.com
APP_ORIGIN=
