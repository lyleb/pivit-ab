# Copy to .env for local development. Do not put real secrets in this file.

# Postgres connection string. Railway injects this on the app service when a
# Postgres plugin is attached.
DATABASE_URL=postgres://user:password@localhost:5432/ab_platform

# Owner login password. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_API_KEY=

# Signs session cookies and preview/edit links. At least 32 characters, any
# character set (it does not have to be hex or base64). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# When NODE_ENV=production the server refuses to boot if this is missing or
# shorter than 32 characters. Outside production a dev-only fallback is used
# and a warning is logged. Set the real value on the host before deploying.
SESSION_SECRET=

# production turns on HTTPS-only cookies and Postgres SSL.
NODE_ENV=development

# Nightly off-site backup. Set these on the Railway cron service, not on the
# web service. When any of the four R2 variables is unset, `node scripts/backup.js`
# logs the missing names and exits 0. See docs/BACKUPS.md.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# How many days of pivitlab-*.dump objects to keep. Unset means 30.
# BACKUP_RETENTION_DAYS=30

# Optional. Only `node scripts/backup.js --local` reads this. The web process
# does not write backups and does not need pg_dump. See docs/BACKUPS.md.
# BACKUP_DIR=

# Optional. npm test uses this Postgres server instead of the local socket,
# and a failed connection fails the tests instead of skipping them. Point it
# at the maintenance database (usually named postgres). The tests create and
# drop their own databases. Never set this to the live Railway database.
# TEST_DATABASE_URL=postgres://pivit:pivit@localhost:5432/postgres

# Strict-Transport-Security max-age, in seconds. Sent only on HTTPS requests
# (Railway sets X-Forwarded-Proto; the app trusts that proxy). Unset uses
# 15552000 (180 days). No includeSubDomains and no preload. Set to 0 to send
# max-age=0, which tells browsers that already stored the policy to drop it.
# That is the rollback. Invalid values are ignored and the default is used.
HSTS_MAX_AGE=

# Port the HTTP server listens on. Railway sets this.
PORT=3000

# How experiments with no site domain are served.
# transition (default) still serves them. enforce never serves them.
HOST_SCOPING=transition

# Public origin for the snippet tag, the client login link and every link in
# email. Also the canonical host on the HTML pages when it is valid. No
# trailing slash. Must be an http or https origin (scheme, host, and an
# optional port). The browser address and the request Host header are not
# used.
# When NODE_ENV=production the server refuses to start unless this is https.
# On Railway set APP_ORIGIN=https://pivitlab.com.
# In development, if this is unset or not a valid origin, those links use
# http://127.0.0.1:$PORT (port 3000 when PORT is unset) and a warning is
# logged. The canonical link still falls back to https://pivitlab.com.
# This does not redirect pivit.click.
# Example: https://pivitlab.com
APP_ORIGIN=

# Optional extra origins allowed to make state-changing requests, comma
# separated. https://pivitlab.com is always allowed, and so is APP_ORIGIN.
# Leave this unset on Railway unless the dashboard is also served from
# another https origin. pivit.click is not implied.
# APP_ORIGINS=

# Postmark server token. Sign-in email is sent with the HTTPS API (Railway
# Hobby blocks SMTP). Leave this empty in development: the message is logged
# and not sent. Do not rotate SESSION_SECRET when you set this.
POSTMARK_SERVER_TOKEN=

# From address on every outgoing email. A bare address is sent as
# "pivitlab" <that address>. Defaults to "pivitlab" <no-reply@pivitlab.com>.
# EMAIL_FROM=no-reply@pivitlab.com

# Reply-To on every outgoing email. Defaults to info@heclr.com.
# pivitlab.com can receive mail. Replies still go to this address.
# EMAIL_REPLY_TO=info@heclr.com

# Postmark message stream. Defaults to outbound.
# POSTMARK_STREAM=outbound

# Optional. If set, Postmark bounce webhooks must send the same value in the
# X-Postmark-Token header. Leave unset and the webhook route stays closed.
# POSTMARK_WEBHOOK_TOKEN=

# Optional. Cloudflare Turnstile. Leave both unset. The widget and the check
# run only when TURNSTILE_SITE_KEY and TURNSTILE_SECRET_KEY are both set.
# With either one missing, sign-in and the access-request form work as they
# do today and the Turnstile script is not loaded.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Public "request access" form on the landing page. Leave unset (or anything
# other than true/1/yes/on) until /privacy.html has real wording. While it is
# off, the page shows a mailto to info@pivitlab.com and the endpoint stores
# nothing.
# ACCESS_REQUESTS_ENABLED=

# Where a new access request is emailed. Defaults to EMAIL_REPLY_TO, which
# itself defaults to info@heclr.com.
# ACCESS_REQUEST_EMAIL=info@heclr.com
